{
  "name": "reverse-investment",
  "productName": "逆思投資",
  "version": "0.1.0",
  "description": "逆思投資 AI 智慧投資顧問 Version 1 桌面展示版",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:electron/* --outfile=out/main/index.cjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --external:electron/* --outfile=out/preload/index.cjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "preview": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "39.8.10",
    "esbuild": "0.25.0",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
